# Config completa (no solo el server block) — para no depender de qué trae
# por defecto el nginx.conf del paquete de Alpine (ej. su propia directiva
# `user`, que chocaría si también se pasa por `-g`) ni de rutas de include
# (fastcgi_params) que puedan variar de una versión a otra.
user root;
worker_processes 1;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;

    server {
        listen ${PORT};
        server_name _;
        root /var/www/html/public;
        index index.php;

        # El .xlsx mensual de la ANT puede pesar 100+ MB — sin esto nginx
        # corta la subida ANTES de que llegue a PHP (mismo valor que
        # post_max_size en php.ini).
        client_max_body_size 260M;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location ~ \.php$ {
            fastcgi_pass 127.0.0.1:9000;
            fastcgi_index index.php;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param QUERY_STRING $query_string;
            fastcgi_param REQUEST_METHOD $request_method;
            fastcgi_param CONTENT_TYPE $content_type;
            fastcgi_param CONTENT_LENGTH $content_length;
            fastcgi_param SCRIPT_NAME $fastcgi_script_name;
            fastcgi_param REQUEST_URI $request_uri;
            fastcgi_param DOCUMENT_URI $document_uri;
            fastcgi_param DOCUMENT_ROOT $document_root;
            fastcgi_param SERVER_PROTOCOL $server_protocol;
            fastcgi_param GATEWAY_INTERFACE CGI/1.1;
            fastcgi_param SERVER_SOFTWARE nginx/$nginx_version;
            fastcgi_param REMOTE_ADDR $remote_addr;
            fastcgi_param REMOTE_PORT $remote_port;
            fastcgi_param SERVER_ADDR $server_addr;
            fastcgi_param SERVER_PORT $server_port;
            fastcgi_param SERVER_NAME $server_name;
            # Empareja con max_execution_time=600 de php.ini — sin esto
            # nginx cortaría la conexión con PHP-FPM antes de que termine
            # de procesar el import de la ANT.
            fastcgi_read_timeout 620;
            fastcgi_send_timeout 620;
        }

        location ~ /\.ht {
            deny all;
        }
    }
}
